  "objectives": [
    "Trong đời sống, học tập và công việc, giao tiếp đầy đủ, mạch lạc về chủ đề có độ phức tạp nhất định.",
    "Hiểu claim, evidence, attitude và discourse structure trong nghe/đọc trung cấp.",
    "Nói và viết đoạn có register, collocation, lập luận, tự sửa và chuyển giao."
  ],
  "topics": [
