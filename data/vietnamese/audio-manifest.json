ese/audio/p02.mp3","segments":{"ma":[0.32,2.192],"Con ma trong câu chuyện không có thật.":[2.512,5.464],"má":[5.784,7.656],"Má của bé hơi đỏ.":[7.976,10.64],"mà":[10.96,12.832],"Tôi muốn đi mà chưa có thời gian.":[13.152,16.2],"mả":[16.52,18.392],"Đây là ngôi mả cũ.":[18.712,21.232],"mã":[21.552,23.424],"Mã sản phẩm ở trên hộp.":[23.744,26.36],"mạ":[26.68,28.552],"Người nông dân đang cấy mạ.":[28.872,31.584],"Bạn nói lại chậm hơn được không?":[31.904,34.64],"Được. Bạn nghe rồi đọc lại nhé.":[34.96,38.848],"ma, má, mà, mả, mã, mạ":[39.168,44.28],"a, ă, â":[44.6,47.12],"á, ắ, ấ":[47.44,50.104],"tiếng Việt, cảm ơn, xin lỗi":[50.424,53.64],"bàn, bán, bạn":[53.96,56.816],"an, ăn":[57.136,59.056],"mắt, mắc":[59.376,61.248]},"seconds":61.568,"bytes":370028},"l01":{"file":"./assets/vietnamese/audio/l01.mp3","segments":{"xin chào":[0.32,2.192],"Xin chào mọi người!":[2.512,4.768],"chào buổi sáng":[5.088,7.128],"Chào buổi sáng, cô Lan!":[7.448,10.184],"tạm biệt":[10.504,12.376],"Tạm biệt, hẹn gặp lại!":[12.696,15.456],"hẹn gặp lại":[15.776,17.792],"Hẹn gặp lại bạn ngày mai.":[18.112,20.68],"cảm ơn":[21.0,22.872],"Cảm ơn anh đã giúp tôi.":[23.192,25.592],"xin lỗi":[25.912,27.736],"Xin lỗi, tôi đến muộn.":[28.056,30.936],"không có gì":[31.256,33.128],"Không có gì, bạn ạ.":[33.448,36.088],"vâng":[36.408,38.28],"Vâng, tôi hiểu rồi.":[38.6,41.048],"dạ":[41.368,43.24],"Dạ, cháu chào bác ạ.":[43.56,46.368],"ạ":[46.688,48.56],"Em cảm ơn cô ạ.":[48.88,51.16],"khỏe":[51.48,53.352],"Hôm nay bạn có khỏe không?":[53.672,56.216],"rất vui":[56.536,58.408],"Tôi rất vui được gặp bạn.":[58.728,61.32],"chúc ngủ ngon":[61.64,63.512],"Chúc bạn ngủ ngon!":[63.832,65.968],"ngày mai":[66.288,68.16],"Ngày mai mình gặp nhau nhé.":[68.48,71.192],"Chào anh! Anh có khỏe không?":[71.512,75.04],"Tôi khỏe, cảm ơn bạn. Còn bạn?":[75.36,79.752],"Tôi cũng khỏe. Rất vui được gặp anh.":[80.072,84.272],"Tôi cũng vậy.":[84.592,86.512],"Tạm biệt anh. Hẹn gặp lại ngày mai!":[86.832,91.032],"Tạm biệt!":[91.352,93.224],"Em chào cô ạ.":[93.544,95.632],"Vâng, em cảm ơn cô ạ.":[95.952,98.832]},"seconds":99.152,"bytes":595532},"l02":{"file":"./assets/vietnamese/audio/l02.mp3","segments":{"tên":[0.32,2.192],"Tên bạn là gì?":[2.512,4.696],"tôi tên là":[5.016,6.936],"Tôi tên là Minh.":[7.256,9.488],"bạn":[9.808,11.68],"Bạn là người nước nào?":[12.0,14.376],"người Việt Nam":[14.696,16.688],"Tôi là người Việt Nam.":[17.008,19.36],"người Trung Quốc":[19.68,21.552],"Anh ấy là người Trung Quốc.":[21.872,24.272],"tiếng Việt":[24.592,26.464],"Tôi đang học tiếng Việt.":[26.784,29.136],"tiếng Trung":[29.456,31.328],"Bạn có nói tiếng Trung không?":[31.648,34.24],"nước nào":[34.56,36.432],"Chị là người nước nào?":[36.752,39.224],"ở đâu":[39.544,41.416],"Bạn sống ở đâu?":[41.736,43.8],"sống":[44.12,45.992],"Tôi sống ở Hải Dương.":[46.312,48.712],"học":[49.032,50.904],"Tôi học tiếng Việt mỗi ngày.":[51.224,53.768],"nói":[54.088,55.96],"Tôi nói tiếng Việt một chút.":[56.28,58.824],"một chút":[59.144,61.016],"Tôi hiểu một chút.":[61.336,63.448],"rất hân hạnh":[63.768,65.688],"Rất hân hạnh được làm quen với anh.":[66.008,68.96],"Xin chào, tôi tên là Lý.":[69.28,72.184],"Chào anh Lý, tôi tên là Lan.":[72.504,75.6],"Tôi là người Việt Nam. Còn anh?":[75.92,79.808],"Tôi là người Trung Quốc. Tôi đang học tiếng Việt.":[80.128,84.712],"Rất vui được làm quen với anh.":[85.032,87.744],"Tôi là người Trung Quốc.":[88.064,90.392],"Bạn tên là gì?":[90.712,92.824]},"seconds":93.144,"bytes":559388},"l03":{"file":"./assets/vietnamese/audio/l03.mp3","segments":{"tôi":[0.32,2.192],"Tôi là nhân viên mới.":[2.512,5.032],"anh":[5.352,7.224],"Anh có rảnh không?":[7.544,9.536],"chị":[9.856,11.728],"Chị giúp tôi với.":[12.048,14.208],"em":[14.528,16.4],"Em chưa hiểu ạ.":[16.72,18.856],"cô":[19.176,21.048],"Cô là giáo viên của em.":[21.368,23.984],"chú":[24.304,26.176],"Chú làm việc ở đây ạ?":[26.496,28.896],"bác":[29.216,31.088],"Cháu chào bác ạ.":[31.408,33.52],"cháu":[33.84,35.712],"Cháu cảm ơn bác ạ.":[36.032,38.336],"chúng tôi":[38.656,40.528],"Chúng tôi là nhân viên mới.":[40.848,43.392],"chúng ta":[43.712,45.584],"Chúng ta cùng học nhé.":[45.904,48.184],"anh ấy":[48.504,50.376],"Anh ấy là đồng nghiệp của tôi.":[50.696,53.312],"chị ấy":[53.632,55.504],"Chị ấy làm ở phòng kế toán.":[55.824,58.56],"mọi người":[58.88,60.752],"Mọi người nghỉ một chút nhé.":[61.072,63.736],"đồng nghiệp":[64.056,65.928],"Lan là đồng nghiệp của tôi.":[66.248,68.84],"Em chào chị ạ. Em là nhân viên mới.":[69.16,72.712],"Chào em. Chị tên là Hoa.":[73.032,76.776],"Em nên xưng hô thế nào ạ?":[77.096,79.64],"Em cứ gọi chị là chị Hoa nhé.":[79.96,82.96],"Vâng, em cảm ơn chị Hoa.":[83.28,86.256],"Chúng ta cùng vào phòng nhé.":[86.576,89.0],"Em chào anh ạ.":[89.32,91.408],"Đây là đồng nghiệp của tôi.":[91.728,94.2]},"seconds":94.52,"bytes":567740},"l04":{"file":"./assets/vietnamese/audio/l04.mp3","segments":{"không":[0.32,2.192],"Số này là số không.":[2.512,4.888],"một":[5.208,7.08],"Tôi mua một cái bút.":[7.4,9.728],"hai":[10.048,11.92],"Tôi cần hai vé.":[12.24,14.424],"ba":[14.744,16.616],"Có ba người ở đây.":[16.936,19.12],"bốn":[19.44,21.312],"Tôi có bốn quyển sách.":[21.632,23.984],"năm":[24.304,26.176],"Tôi mua năm quả táo.":[26.496,29.064],"sáu":[29.384,31.256],"Có sáu cái ghế.":[31.576,33.736],"bảy":[34.056,35.928],"Nhóm tôi có bảy người.":[36.248,38.576],"tám":[38.896,40.768],"Tôi cần tám cái hộp.":[41.088,43.56],"chín":[43.88,45.752],"Có chín sản phẩm.":[46.072,48.328],"mười":[48.648,50.52],"Tôi có mười nghìn đồng.":[50.84,53.144],"trăm":[53.464,55.336],"Giá là một trăm nghìn đồng.":[55.656,58.2],"nghìn":[58.52,60.392],"Cái này giá hai mươi nghìn đồng.":[60.712,63.328],"đồng":[63.648,65.52],"Tổng cộng là năm mươi nghìn đồng.":[65.84,68.624],"Cái này bao nhiêu tiền?":[68.944,71.224],"Hai mươi lăm nghìn đồng.":[71.544,73.824],"Tôi mua hai cái.":[74.144,76.4],"Đây là một trăm nghìn đồng.":[76.72,79.216],"Tôi gửi lại anh năm mươi nghìn đồng.":[79.536,82.392],"Có phải năm mươi nghìn đồng không?":[82.712,85.304]},"seconds":85.624,"bytes":514316},"l05":{"file":"./assets/vietnamese/audio/l05.mp3","segments":{"hôm nay":[0.32,2.336],"Hôm nay là thứ hai.":[2.656,4.936],"hôm qua":[5.256,7.128],"Hôm qua tôi đi làm.":[7.448,9.776],"ngày":[10.096,11.968],"Hôm nay là ngày mấy?":[12.288,14.592],"tháng":[14.912,16.784],"Tôi đến Việt Nam vào tháng ba.":[17.104,19.864],"năm nay":[20.184,22.056],"Năm nay tôi học tiếng Việt.":[22.376,24.992],"tuần":[25.312,27.184],"Tuần này tôi khá bận.":[27.504,29.904],"thứ hai":[30.224,32.096],"Thứ hai tôi đi làm.":[32.416,34.672],"chủ nhật":[34.992,36.864],"Chủ nhật tôi nghỉ.":[37.184,39.344],"giờ":[39.664,41.536],"Bây giờ là mấy giờ?":[41.856,44.256],"phút":[44.576,46.448],"Tôi cần mười phút.":[46.768,48.904],"buổi sáng":[49.224,51.096],"Buổi sáng tôi uống cà phê.":[51.416,54.08],"buổi chiều":[54.4,56.272],"Buổi chiều chúng ta gặp nhau nhé.":[56.592,59.352],"buổi tối":[59.672,61.544],"Buổi tối tôi học ở nhà.":[61.864,64.408],"mấy giờ":[64.728,66.6],"Mấy giờ anh đi làm?":[66.92,69.296],"Ngày mai anh có rảnh không?":[69.616,72.232],"Có. Chúng ta gặp nhau lúc mấy giờ?":[72.552,76.584],"Lúc hai giờ chiều nhé.":[76.904,79.28],"Được. Ngày mai là thứ ba phải không?":[79.6,83.728],"Vâng, ngày mười tháng ba.":[84.048,86.856],"Hẹn gặp anh vào ngày mai.":[87.176,89.744],"Hôm nay là thứ sáu.":[90.064,92.392],"Bảy giờ ba mươi phút.":[92.712,95.064]},"seconds":95.384,"bytes":572924},"l06":{"file":"./assets/vietnamese/audio/l06.mp3","segments":{"gia đình":[0.32,2.192],"Gia đình tôi có bốn người.":[2.512,5.032],"bố":[5.352,7.224],"Bố tôi là kỹ sư.":[7.544,9.872],"mẹ":[10.192,12.064],"Mẹ tôi nấu ăn rất ngon.":[12.384,15.12],"ông":[15.44,17.312],"Ông tôi sống ở quê.":[17.632,19.984],"bà":[20.304,22.176],"Bà tôi thích uống trà.":[22.496,24.872],"anh trai":[25.192,27.064],"Anh trai tôi làm ở Hà Nội.":[27.384,30.072],"chị gái":[30.392,32.264],"Chị gái tôi là giáo viên.":[32.584,35.176],"em trai":[35.496,37.368],"Em trai tôi còn đi học.":[37.688,40.184],"em gái":[40.504,42.376],"Em gái tôi mười tuổi.":[42.696,45.144],"con":[45.464,47.336],"Tôi có một con gái.":[47.656,49.984],"vợ":[50.304,52.176],"Vợ tôi là người Việt Nam.":[52.496,55.016],"chồng":[55.336,57.208],"Chồng chị làm nghề gì?":[57.528,59.904],"người thân":[60.224,62.096],"Cuối tuần tôi gọi cho người thân.":[62.416,65.128],"bạn bè":[65.448,67.32],"Tôi thường đi chơi với bạn bè.":[67.64,70.376],"Gia đình anh có mấy người?":[70.696,73.168],"Anh có anh chị em không?":[73.488,75.96],"Tôi có một em gái. Còn chị?":[76.28,80.192],"Tôi có một anh trai.":[80.512,82.816],"Anh trai chị làm nghề gì?":[83.136,85.68],"Đây là em gái của tôi.":[86.0,88.592]},"seconds":88.912,"bytes":534044},"l07":{"file":"./assets/vietnamese/audio/l07.mp3","segments":{"ăn":[0.32,2.192],"Tôi muốn ăn phở.":[2.512,4.888],"uống":[5.208,7.08],"Anh uống nước nhé.":[7.4,9.464],"cơm":[9.784,11.656],"Tôi ăn cơm ở công ty.":[11.976,14.544],"phở":[14.864,16.736],"Cho tôi một bát phở bò.":[17.056,19.648],"nước":[19.968,21.84],"Cho tôi một cốc nước.":[22.16,24.464],"cà phê":[24.784,26.656],"Tôi uống cà phê không đường.":[26.976,29.64],"thịt bò":[29.96,31.832],"Tôi không ăn thịt bò.":[32.152,34.6],"thịt gà":[34.92,36.792],"Món này có thịt gà không?":[37.112,39.704],"rau":[40.024,41.896],"Tôi muốn thêm rau.":[42.216,44.4],"ngon":[44.72,46.592],"Món này rất ngon.":[46.912,49.192],"cay":[49.512,51.384],"Tôi không ăn được cay.":[51.704,54.128],"không đường":[54.448,56.32],"Cho tôi cà phê không đường.":[56.64,59.256],"thực đơn":[59.576,61.448],"Cho tôi xem thực đơn với.":[61.768,64.48],"tính tiền":[64.8,66.672],"Chị ơi, cho tôi tính tiền.":[66.992,69.968],"Chị ơi, cho tôi xem thực đơn với.":[70.288,73.696],"Vâng, anh muốn ăn gì ạ?":[74.016,76.752],"Cho tôi một bát phở bò, không cay.":[77.072,80.432],"Anh uống gì ạ?":[80.752,82.744],"Cho tôi một cốc nước. Cảm ơn chị.":[83.064,87.144],"Vâng, anh chờ một chút nhé.":[87.464,90.368],"Cho tôi một bát phở gà ạ.":[90.688,93.496]},"seconds":93.816,"bytes":563420},"l08":{"file":"./a