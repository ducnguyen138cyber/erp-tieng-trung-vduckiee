  "grammar": [
    {
      "title": "称呼放进问候里",
      "body": "日常常用 Chào + 称呼。面对年长男性可说 Chào anh；对老师可说 Em chào cô ạ。xin chào 适合中性场合，但不必每次都说。",
      "vi": "Em chào cô ạ.",
      "zh": "老师好。"
    },
    {
      "title": "礼貌不是逐字翻译",
      "body": "ạ 常放在句末；vâng/dạ 是礼貌应答。北部常用 vâng，dạ 在越南各地也使用。不要把 ạ 当成普通话的“啊”。",
      "vi": "Vâng, em cảm ơn cô ạ.",
      "zh": "好的，谢谢老师。"
    }
  ],
  "dialogue": [
    {
      "speaker": "A",
      "vi": "Chào anh! Anh có khỏe không?",
      "zh": "你好！你身体好吗？"
    },
    {
      "speaker": "B",
      "vi": "Tôi khỏe, cảm ơn bạn. Còn bạn?",
      "zh": "我很好，谢谢你。你呢？"
    },
    {
      "speaker": "A",
      "vi": "Tôi cũng khỏe. Rất vui được gặp anh.",
      "zh": "我也很好。很高兴见到你。"
    },
    {
      "speaker": "B",
      "vi": "Tôi cũng vậy.",
      "zh": "我也是。"
    },
    {
      "speaker": "A",
      "vi": "Tạm biệt anh. Hẹn gặp lại ngày mai!",
      "zh": "再见，明天见！"
    },
    {
      "speaker": "B",
      "vi": "Tạm biệt!",
      "zh": "再见！"
    }
  ],
