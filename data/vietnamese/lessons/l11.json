  "grammar": [
    {
      "title": "请求帮助，不假装听懂",
      "body": "…giúp tôi nhé 是礼貌请求；nói lại chậm hơn 表示再慢一点说。不明白工作指令时说 Tôi chưa hiểu，尤其安全事项必须确认。",
      "vi": "Anh nói lại chậm hơn giúp tôi nhé.",
      "zh": "请您再慢一点说一遍。"
    },
    {
      "title": "cần、phải 与被动状态",
      "body": "cần + 动词=需要；phải + 动词=必须。bị 常引出不利状态，如 bị lỗi。它不是所有被动句都必须用的词。",
      "vi": "Sản phẩm này cần kiểm tra.",
      "zh": "这个产品需要检查。"
    }
  ],
  "dialogue": [
