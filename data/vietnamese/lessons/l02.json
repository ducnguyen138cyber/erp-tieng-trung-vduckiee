  "grammar": [
    {
      "title": "A là B",
      "body": "là 用于身份、姓名等名词性判断；描述“好、忙、饿”时一般不加 là。",
      "vi": "Tôi là người Trung Quốc.",
      "zh": "我是中国人。"
    },
    {
      "title": "疑问词留在所问的位置",
      "body": "gì（什么）、ở đâu（在哪里）、nước nào（哪个国家）通常留在句中原本的位置，不必搬到句首。",
      "vi": "Bạn tên là gì?",
      "zh": "你叫什么名字？"
    }
  ],
