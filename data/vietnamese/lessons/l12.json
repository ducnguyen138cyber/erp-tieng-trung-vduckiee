  "grammar": [
    {
      "title": "确认与请求许可",
      "body": "…đúng không？确认信息是否正确；…được không？请求许可。có thể…không？询问能力或可能性，语气通常更客气。",
      "vi": "Tôi ngồi đây được không?",
      "zh": "我可以坐这里吗？"
    },
    {
      "title": "把已学内容连接起来",
      "body": "rồi 可接“然后”；và 表示“和/并且”；nhưng 表示“但是”。先用短句说明，再提问题，不必把整句中文逐字翻译。",
      "vi": "Tôi là người Trung Quốc nhưng tôi hiểu một chút tiếng Việt.",
      "zh": "我是中国人，不过我懂一点越南语。"
    }
  ],
  "dialogue": [
