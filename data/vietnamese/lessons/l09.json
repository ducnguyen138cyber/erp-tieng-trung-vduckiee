  "grammar": [
    {
      "title": "地点与方向",
      "body": "地点 + ở đâu？询问在哪里；đi thẳng/rẽ trái/rẽ phải 常用于指路。trái/phải 不是“对/错”，这里是左/右。",
      "vi": "Nhà vệ sinh ở đâu ạ?",
      "zh": "请问卫生间在哪里？"
    },
    {
      "title": "交通工具前常用 bằng",
      "body": "đi + bằng + 交通工具，如 đi bằng xe buýt。步行直接说 đi bộ，不说 đi bằng đi bộ。",
      "vi": "Tôi đi bằng xe buýt.",
      "zh": "我坐公交车去。"
    }
  ],
  "dialogue": [
    {
      "speaker": "A",
      "vi": "Xin lỗi, nhà vệ sinh ở đâu ạ?",
      "zh": "不好意思，请问卫生间在哪里？"
    },
    {
      "speaker": "B",
      "vi": "Anh đi thẳng rồi rẽ phải.",
      "zh": "您直走，然后右转。"
    },
    {
      "speaker": "A",
      "vi": "Có xa không ạ?",
      "zh": "远吗？"
    },
    {
      "speaker": "B",
      "vi": "Không xa, khoảng năm mươi mét.",
      "zh": "不远，大约五十米。"
    },
    {
      "speaker": "A",
      "vi": "Cảm ơn chị nhiều.",
      "zh": "非常感谢您。"
    },
    {
      "speaker": "B",
      "vi": "Không có gì.",
      "zh": "不客气。"
    }
  ],
