  "grammar": [
    {
      "title": "星期不从一开始",
      "body": "星期一=thứ hai，星期二=thứ ba，一直到星期六=thứ bảy；星期日=chủ nhật。不要把 thứ hai 译成星期二。",
      "vi": "Hôm nay là thứ sáu.",
      "zh": "今天是星期五。"
    },
    {
      "title": "时间、日期的常见顺序",
      "body": "日期通常按 ngày + 日，tháng + 月，năm + 年。时间用 số + giờ + số + phút；giờ rưỡi 表示半点。询问数量或时间用 mấy。",
      "vi": "Bảy giờ ba mươi phút.",
      "zh": "七点三十分。"
    }
  ],
