  "grammar": [
    {
      "title": "礼貌点餐",
      "body": "Cho tôi + 数量 + 单位 + 菜品 是常见请求。bát（碗）、cốc（杯）跟在数字后；加 với、ạ 可更客气。",
      "vi": "Cho tôi một bát phở gà ạ.",
      "zh": "请给我一碗鸡肉河粉。"
    },
    {
      "title": "想、不吃与不能吃",
      "body": "muốn + 动词 表示想做；không ăn 表示不吃；không ăn được 常表示吃不了。过敏请直说 Tôi bị dị ứng với…，不要只说不喜欢。",
      "vi": "Tôi không ăn được cay.",
      "zh": "我吃不了辣。"
    }
  ],
