  "grammar": [
    {
      "title": "有、没有与人数",
      "body": "có 表示有，không có 表示没有。家庭有几个人常说 Gia đình + 人 + có + 数量 + người。",
      "vi": "Gia đình tôi có bốn người.",
      "zh": "我家有四口人。"
    },
    {
      "title": "修饰语通常在名词后",
      "body": "anh trai、chị gái、con gái 中，后面的词限定前面的名词。所属结构可用 của；亲属词后直接接 tôi 也自然，如 mẹ tôi。",
      "vi": "Đây là em gái của tôi.",
      "zh": "这是我的妹妹。"
    }
  ],
