  "grammar": [
    {
      "title": "动词本身不按人称变形",
      "body": "越南语不像英语那样按人称给动词加词尾；用时间词和语境表达时间。đã、đang、sẽ 常放在动词前，但不能机械对应每一种汉语时态。",
      "vi": "Tôi đang học tiếng Việt.",
      "zh": "我正在学越南语。"
    },
    {
      "title": "时间与否定",
      "body": "hôm nay/ngày mai 可放句首；không 放在主要动词或形容词前。chưa 是“还没”；không 是“不”。",
      "vi": "Tôi chưa ăn sáng.",
      "zh": "我还没吃早饭。"
    }
  ],
