  "grammar": [
    {
      "title": "này、kia 跟在名词后",
      "body": "cái này/cái kia 常用于物品；具体商品可说 áo này。数量通常在量词前：hai cái áo。不是所有名词都用 cái。",
      "vi": "Tôi lấy hai cái áo này.",
      "zh": "我要这两件上衣。"
    },
    {
      "title": "比较和询问可能性",
      "body": "形容词 + hơn 表示“更……”。礼貌询问用 có thể + 动词 + không？转账前仍需核对收款人、币种与金额。",
      "vi": "Cái này rẻ hơn.",
      "zh": "这个更便宜。"
    }
  ],
